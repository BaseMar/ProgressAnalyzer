# Persistent app: streamlit run personal_app.py
# Initialize once with python -m db.bootstrap --url sqlite:///demo.sqlite3 --demo
# streamlit_app.py uses this URL only after the owner unlocks Personal.
DATABASE_URL=sqlite:///demo.sqlite3

# Optional owner access on the shared hosted entry point.
# Generate a verifier with: python -m services.personal_access
# PERSONAL_PASSWORD_HASH=pbkdf2_sha256$600000$...$...

# PostgreSQL alternative: create an empty database and initialize its schema.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/progress_analyzer_demo

# Optional Docker host port; Compose supplies its own internal database URL.
# DEMO_PORT=8502
