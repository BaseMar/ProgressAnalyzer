# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Build output and package metadata
build/
dist/
*.egg-info/
*.dist-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Test, analysis and temporary artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/
*.log

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
*.venv

# Local configuration, credentials and backups
.env
.env.*
.streamlit/*
!.streamlit/config.toml
backup_db.py
backups/
user_settings/
*.db
*.sqlite
*.sqlite3
*.pdf

# Editor and operating-system files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Keep dependency manifests trackable under external text-file ignore rules.
!requirements.txt
!requirements-dev.txt
